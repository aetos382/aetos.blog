---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../url';

// `href` is a site-relative path without the base path (for example `/blog`).
type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
const pathname = '/' + Astro.url.pathname.slice(withBase('/').length);
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={withBase(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
